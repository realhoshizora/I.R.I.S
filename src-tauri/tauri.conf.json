{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "I.R.I.S",
  "version": "0.1.0",
  "identifier": "app.iris.translator",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "popup", "url": "popup.html", "width": 420, "height": 160, "visible": false, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "shadow": false, "focus": false },
      { "label": "fab", "url": "fab.html", "width": 44, "height": 44, "visible": false, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "shadow": false, "focus": false, "focusable": false },
      { "label": "overlay", "url": "overlay.html", "visible": false, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "shadow": false, "focus": false },
      { "label": "settings", "url": "settings.html", "title": "I.R.I.S · Cài đặt", "width": 480, "height": 680, "minWidth": 400, "minHeight": 480, "visible": false, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
